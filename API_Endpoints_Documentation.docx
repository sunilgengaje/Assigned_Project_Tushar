1. Endpoint: /manage-aggregator
Method: POST
Encryption: Encrypted (AES-GCM + base64)

Request Body (Plain):
{
  "aggregatorName": "Test Aggregator",
  "email": "test@example.com",
  "isDeleted": false
}

Request Body (Encrypted):
{
  "data": "<base64-encoded AES-GCM encrypted JSON>"
}

Response (Plain):
{
  "aggregatorId": 1,
  "aggregatorName": "Test Aggregator",
  "email": "test@example.com",
  "isDeleted": false
}

Response (Encrypted):
{
  "data": "<base64-encoded AES-GCM encrypted JSON>"
}

